  dialogue:
  - 'You: What do you like to do for fun? '
  - 'Date: I love the arts. In my free time I feel called to paint.'
  - 'Date: Do you want to see one of my paintings? '
  - "Date: I wanted to express my feelings towards women\u2019s period cramps. "
  responses:
