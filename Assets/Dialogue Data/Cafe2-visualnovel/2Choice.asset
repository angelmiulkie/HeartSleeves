  m_Name: 2Choice
  m_EditorClassIdentifier: Assembly-CSharp::DialogueObject
  dialogue:
  - "Date: \u2026So what kind of music do you like to listen to? "
  - 'You: Oh, I enjoy listening to lots of artists. '
  - "You:  I\u2019ve been listening to a lot of Loafy actually. "
  - "Date: Really? I\u2019m surprised, they are so underground. "
  - "Date: Can you even name 3 songs by them then? \r\n"
  responses:
  - responseText: Defend Yourself
    dialogueObject: {fileID: 11400000, guid: 59bb51213518c954ba6ed1c939bf6a27, type: 2}
  - responseText: Panic
    dialogueObject: {fileID: 11400000, guid: 0085113aaee7d6046ab76844728ac647, type: 2}
